# BotFather bergan token
BOT_TOKEN=123456:AAAA-BBBB

# Admin Telegram ID si (@userinfobot dan olinadi)
ADMIN_ID=123456789

# Videolar saqlanadigan yopiq arxiv kanal ID si (-100... bilan boshlanadi).
# Bot o'sha kanalda admin bo'lishi shart.
ARCHIVE_CHANNEL_ID=-1001234567890

# SQLite fayl yo'li
DB_PATH=qogoz.db

# Modullar (false = router ham, tugmalar ham ko'rinmaydi)
FEATURE_YUKLASH=false
FEATURE_TAKLIF=false

# --- Qo'shimcha modullar (hammasi o'chiq; kerakligini true qiling) ---
FEATURE_BILDIRISHNOMA=false   # yangi qism chiqqanda tomoshabinlarga xabar
FEATURE_RAQAM=false           # serial ekranida qism raqamini yozib o'tish
FEATURE_ROYXATIM=false        # "Mening ro'yxatim" — ko'rilayotgan seriallar
FEATURE_ULASHISH=false        # serial kartochkasida "Ulashish" tugmasi
FEATURE_JANR=false            # janr bo'yicha ro'yxat
FEATURE_OBUNA=false           # majburiy obuna
FEATURE_AVTOPOST=false        # yangi serial/qismni kanalga e'lon qilish
FEATURE_ZAXIRA=false          # bazani avtomatik zaxiralash
FEATURE_ANTIFLOOD=false       # tez-tez bosishdan himoya

# FEATURE_OBUNA uchun: vergul bilan, @nom yoki -100...
OBUNA_KANALLAR=
# FEATURE_AVTOPOST uchun ochiq kanal
POST_CHANNEL_ID=
# FEATURE_ZAXIRA sozlamalari
ZAXIRA_SOAT=24
ZAXIRA_SAQLASH=7

# --- Ikkinchi to'plam (hammasi o'chiq) ---
FEATURE_KANAL_IMPORT=false    # arxiv kanaldagi "Nomi | 5" captionli videoni avtomatik qo'shish
FEATURE_FUZZY=false           # xatoga chidamli qidiruv
FEATURE_BUYRUQLAR=false       # "/" menyusi (setMyCommands)
FEATURE_INLINE=false          # inline rejim: @bot <nom>
FEATURE_JURNAL=false          # xatolar va hodisalar jurnali
FEATURE_SQLITE_FSM=false      # FSM holatini SQLite da saqlash (restartda yo'qolmaydi)
FEATURE_KORILGAN=false        # ko'rilgan qismga ✓
FEATURE_QIDIRUV_JURNALI=false # qidirilgan, lekin topilmagan so'rovlar
FEATURE_KUZATISH=false        # 🔔 Kuzatish (sevimlilar)
FEATURE_FASL=false            # fasl (season) qo'llab-quvvatlash
FEATURE_MANBA=false           # ?start=ref_<manba> kuzatuvi
FEATURE_QISM_ALMASH=false     # qism videosini almashtirish
FEATURE_REJA=false            # rejalashtirilgan tarqatish
FEATURE_BAHO=false            # 👍/👎 va "Eng yaxshilar"
FEATURE_KASHFIYOT=false       # 🎲 Tasodifiy va 🆕 Yangilar
FEATURE_TIL=false             # uz/ru interfeys
FEATURE_CSV=false             # CSV import/eksport
FEATURE_TUR=false             # kino va serialni ajratish

# Qo'shimcha adminlar (vergul bilan)
ADMIN_IDS=
# Xatolar/hodisalar yoziladigan kanal
LOG_CHANNEL_ID=
# Zaxira faylini adminga yuborish
ZAXIRA_ADMINGA=true
